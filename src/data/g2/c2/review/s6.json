   "id": "g2.simul.review.integer-swap-digits-1",
   "rev": 1,
   "editions": {
    "2026": {
     "page": 40,
     "number": "類6.2"
    }
   },
   "type": "similar",
   "group": "s6",
   "related": {
    "original": [
     "g2.simul.integer.q-swap-digits-1"
    ]
   },
   "title": "2けたの整数と位の入れかえ",
   "statement": [
    {
     "id": "q-text",
     "type": "text",
     "area": "top",
     "text": "2けたの整数Aがある。この整数Aは，[[c1|十の位の数の9倍より10大きい]]。また，[[sw|整数Aの十の位の数と一の位の数を入れかえた整数をB]]とすると，[[c2|整数Aは整数Bより54大きい]]。このとき，整数Aの値を求めなさい。"
    }
   ],
   "answer": {
    "text": "82",
    "values": {
     "x": 8,
     "y": 2,
     "A": 82,
     "B": 28
    }
   },
   "check": {
    "equations": [
     "10*x+y=9*x+10",
     "10*x+y=10*y+x+54"
    ],
    "solution": {
     "x": 8,
     "y": 2,
     "A": 82,
     "B": 28
    },
    "derived": [
     "x+y=10",
     "9*x-9*y=54",
     "x-y=6",
     "2*x=16",
     "8+y=10",
     "A=10*x+y",
     "B=10*y+x"
    ],
    "identities": [
     "(10*x+y)-(9*x+10)=x+y-10",
     "(10*x+y)-(10*y+x)=9*x-9*y",
     "9*8+10=82",
     "82-28=54"
    ]
   },
   "hints": [
    "十の位の数が $x$，一の位の数が $y$ の2けたの整数は $10x+y$。",
    "入れかえた整数は $10y+x$。"
   ],
   "steps": [
    {
     "id": "place",
     "title": "位取り表で A，B を表す",
     "add": [
      {
       "id": "let",
       "type": "text",
       "area": "left",
       "text": "Aの十の位の数を $\\tc{blue}{x}$，一の位の数を $\\tc{orange}{y}$ とする。"
      },
      {
       "id": "pv",
       "type": "place",
       "area": "left",
       "labels": [
        "十の位",
        "一の位"
       ],
       "cards": [
        {
         "id": "x",
         "label": "x",
         "color": "blue",
         "key": "cx"
        },
        {
         "id": "y",
         "label": "y",
         "color": "orange",
         "key": "cy"
        }
       ],
       "states": [
        {
         "id": "A",
         "order": [
          "x",
          "y"
         ],
         "tex": "A=10\\tc{blue}{x}+\\tc{orange}{y}"
        },
        {
         "id": "B",
         "order": [
          "y",
          "x"
         ],
         "tex": "B=10\\tc{orange}{y}+\\tc{blue}{x}"
        },
        {
         "id": "A-num",
         "order": [
          "x",
          "y"
         ],
         "values": {
          "x": "8",
          "y": "2"
         },
         "tex": "A=82"
        },
        {
         "id": "B-num",
         "order": [
          "y",
          "x"
         ],
         "values": {
          "x": "8",
          "y": "2"
         },
         "tex": "B=28"
        }
       ]
      }
     ],
     "comment": "十の位の $x$ は「10が $x$ 個」→ $A=10x+y$。",
     "teacherNote": {
      "text": "指導書の解答では，Aの十の位の数を $x$，一の位の数を $y$ としている。",
      "source": "material"
     }
    },
    {
     "id": "swap",
     "title": "位を入れかえる",
     "set": {
      "pv": "B"
     },
     "emphasis": [
      {
       "key": "sw",
       "style": "marker",
       "color": "yellow"
      }
     ],
     "comment": "入れかえた整数は $B=10y+x$。"
    },
    {
     "id": "eqs",
     "title": "2つの方程式",
     "add": [
      {
       "id": "eqs",
       "type": "calc",
       "area": "right",
       "rows": [
        {
         "key": "e1",
         "label": "①",
         "cells": [
          "10x+y",
          "=",
          "9x+10"
         ]
        },
        {
         "key": "e1b",
         "label": "①より",
         "cells": [
          "x+y",
          "=",
          "10",
          {
           "text": "……①'"
          }
         ]
        },
        {
         "key": "e2",
         "label": "②",
         "cells": [
