          "=",
          "10y+x+54"
         ]
        },
        {
         "key": "e2b",
         "label": "②より",
         "cells": [
          "9x-9y",
          "=",
          "54"
         ]
        },
        {
         "key": "e2c",
         "label": "÷9",
         "cells": [
          "x-y",
          "=",
          "6",
          {
           "text": "……②'"
          }
         ]
        }
       ],
       "hide": [
        "e2",
        "e2b",
        "e2c"
       ],
       "align": [
        "r",
        "c",
        "l",
        "l"
       ]
      }
     ],
     "emphasis": [
      {
       "keys": [
        "c1",
        "e1"
       ],
       "style": "marker",
       "color": "yellow"
      }
     ],
     "comment": "「十の位の数の9倍より10大きい」→ $10x+y=9x+10$，整理して $x+y=10$。"
    },
    {
     "id": "eq2",
     "title": "2つ目の条件",
     "reveal": [
      "e2",
      "e2b",
      "e2c"
     ],
     "emphasis": [
      {
       "keys": [
        "c2",
        "e2"
       ],
       "style": "marker",
       "color": "yellow"
      }
     ],
     "comment": "「AはBより54大きい」→ $10x+y=10y+x+54$。整理して $9x-9y=54$，$x-y=6$。"
    },
    {
     "id": "solve",
     "title": "①'＋②' で解く",
     "remove": [
      "eqs"
     ],
     "add": [
      {
       "id": "el",
