         "cells": [
          "8+y",
          "=",
          "10"
         ]
        },
        {
         "cells": [
          "y",
          "=",
          "2"
         ]
        }
       ]
      }
     ],
     "comment": "$2x=16$ → $x=8$。$8+y=10$ → $y=2$。"
    },
    {
     "id": "num",
     "title": "位取り表に数を入れる",
     "set": {
      "pv": "B-num"
     },
     "comment": "入れかえた整数Bは28。"
    },
    {
     "id": "answer",
     "title": "答え",
     "set": {
      "pv": "A-num"
     },
     "add": [
      {
       "id": "ans",
       "type": "answer",
       "area": "right",
       "text": "82"
      }
     ],
     "comment": "整数Aは82。確かめ：$9\\times8+10=82$，$82-28=54$。"
    }
   ],
