    ]
   },
   "title": "代入法（y＝… の形）",
   "statement": [
    {
     "id": "q-text",
     "type": "text",
     "area": "top",
     "text": "次の連立方程式を解きなさい。"
    },
    {
     "id": "q-eq",
     "type": "math",
     "area": "top",
     "size": "l",
     "tex": "\\begin{cases} y=\\hl{src}{x+3} \\cdots\\!\\cdots\\text{①} \\\\ x+\\hl{tgt}{y}=5 \\cdots\\!\\cdots\\text{②} \\end{cases}"
    }
   ],
   "answer": {
    "tex": "\\begin{cases} x=1 \\\\ y=4 \\end{cases}",
    "values": {
     "x": 1,
     "y": 4
    }
   },
   "check": {
    "equations": [
     "y=x+3",
     "x+y=5"
    ],
    "solution": {
     "x": 1,
     "y": 4
    },
    "derived": [
     "x+(x+3)=5",
     "2*x+3=5",
     "2*x=2"
    ],
    "identities": []
   },
   "hints": [
    "①は「$y=\\cdots$」の形。",
    "②の $y$ に $x+3$ を代入しよう。"
   ],
   "steps": [
    {
     "id": "focus",
     "title": "代入する式を見つける",
     "emphasis": [
      {
       "key": "src",
       "style": "box",
       "color": "green"
      },
      {
       "key": "tgt",
       "style": "box",
       "color": "orange"
      }
     ],
     "arrows": [
      {
       "from": "src",
       "to": "tgt",
       "color": "green"
      }
     ],
     "add": [
      {
       "id": "plan",
       "type": "callout",
       "area": "right",
       "tone": "point",
       "text": "①の $y=x+3$ を，②の $y$ に代入する"
      }
     ],
     "comment": "一方の式が「文字＝…」の形なので，**代入法** で解く。"
    },
    {
     "id": "substitute",
     "title": "代入して1つの文字を消す",
     "anim": "slide-up",
     "add": [
      {
       "id": "sb",
       "type": "calc",
       "area": "left",
       "rows": [
        {
         "label": "②に①を代入",
         "cells": [
          "x+\\hl{sub}{(x+3)}",
          "=",
          "5"
         ]
        },
        {
         "key": "r2",
         "cells": [
          "2x+3",
          "=",
          "5"
         ]
        },
        {
         "key": "r3",
         "cells": [
          "2x",
          "=",
          "2"
         ]
        },
        {
         "key": "r4",
         "cells": [
          "x",
          "=",
          "\\hl{v1}{1}"
         ]
        }
       ],
       "size": "l",
       "hide": [
        "r2",
        "r3",
        "r4"
       ]
      }
     ],
     "emphasis": [
      {
       "key": "sub",
       "style": "box",
       "color": "green"
      }
     ],
     "comment": "②の $y$ のところに $(x+3)$ を入れる。$y$ が消えて $x$ だけの式になる。"
    },
    {
     "id": "solve",
     "title": "方程式を解く",
     "reveal": [
      "r2",
      "r3",
      "r4"
     ],
     "emphasis": [
      {
       "key": "r4",
       "style": "marker",
       "color": "yellow"
      }
     ],
     "comment": "$2x+3=5$ → $2x=2$ → $x=1$。"
    },
    {
     "id": "back",
     "title": "もう1つの値を求める",
     "remove": [
      "plan"
     ],
     "add": [
      {
       "id": "back-label",
       "type": "text",
       "area": "right",
       "text": "①に $x=1$ を代入"
      },
      {
       "id": "bk",
       "type": "calc",
       "area": "right",
       "rows": [
        {
         "cells": [
          "y",
          "=",
          "\\hl{sv}{1}+3"
         ]
        },
        {
         "cells": [
          "",
          "=",
          "4"
         ]
        }
       ],
       "size": "l"
      }
     ],
     "emphasis": [
      {
       "keys": [
        "v1",
        "sv"
       ],
       "style": "box",
       "color": "green"
      }
     ],
     "comment": "$y=1+3=4$。"
    },
    {
     "id": "answer",
     "title": "答え",
     "add": [
      {
       "id": "ans",
       "type": "answer",
       "area": "right",
       "tex": "\\begin{cases} x=1 \\\\ y=4 \\end{cases}"
      }
     ],
     "comment": "答えは $x$ と $y$ の値を組にして書く。"
    }
   ],
   "teacher": {
    "status": "draft",
    "aim": "「y＝…」の式をもう一方の式に代入して，1つの文字を消去する。",
    "notes": [
     {
      "text": "指導書の答え：$x=1,\\ y=4$",
      "source": "material"
