              ],
              "states": [
                {
                  "id": "real",
                  "motion": {
                    "legs": [{ "distance": 10, "speed": 5, "distanceVar": "x" }, { "distance": 14, "speed": 7, "distanceVar": "y" } ],
                    "expect": { "time": 4, "distance": 24},
                    "timeUnit": "時間",
                    "secondsPerUnit": 1.5,
                    "scaleText": "（1時間を1.5秒で再生）"
                  },
                  "note": "※ 線の長さは実際の道のりの比（10：14）"
