                  "w": 14,
                  "key": "sBC2",
                  "top": { "text": "$14$ km", "key": "ry2" },
                  "bottom": [{ "text": "時速7km →", "key": "rv72" }, { "text": "$14\\div7=2$ 時間", "key": "rt72" } ]
